# Copy to .env and adjust. These values are for running on your own machine, not for a server
# other people can reach: change every password and secret before exposing it.

# Postgres
POSTGRES_USER=agropal
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_NAME=agropal

# RabbitMQ. Keep the password to letters and numbers: it is put into a connection URL.
RABBITMQ_USERNAME=agropal
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# Secrets for signing tokens and encrypting refresh tokens. Use long random strings, for example
# the output of: openssl rand -hex 32. The API refuses to start with a secret under 32 characters.
SECRET_JWT=change-me-run-openssl-rand-hex-32
SECRET_GCM_TOKEN=change-me-run-openssl-rand-hex-32

# Email. The defaults use the mail catcher in this compose file (no login needed).
# For a real provider, set these and remove the mailpit service.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_FROM=no-reply@example.com
# SECRET_SMTP=

# Frontend. NEXT_PUBLIC_* values are baked in when the image is built, so run
# `docker compose up --build` again after changing them.
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Development only: return one-time codes in API responses (lets anyone verify any email)
# EXPOSE_CODES=true
