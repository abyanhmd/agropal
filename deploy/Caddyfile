# One origin for everything, so the sign-in cookie is first-party and the API needs no CORS.
# Caddy obtains and renews the HTTPS certificate on its own.
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
