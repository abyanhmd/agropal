# Production settings for docker-compose.prod.yaml. Copy to .env on the server and fill in every value:
#   cp .env.prod.example .env
#   docker compose -f docker-compose.prod.yaml up -d --build

# Public hostname Caddy gets a certificate for. Its DNS A record must point at this server.
DOMAIN=agropal.example.com

POSTGRES_USER=agropal
POSTGRES_PASSWORD=change-me
POSTGRES_NAME=agropal

# Letters and numbers only: it is put into a connection URL
RABBITMQ_USERNAME=agropal
RABBITMQ_PASSWORD=change-me

# At least 32 characters each, e.g. the output of: openssl rand -hex 32
SECRET_JWT=change-me
SECRET_GCM_TOKEN=change-me

# Real SMTP provider (Resend, Brevo, Mailgun, ...). Set up SPF/DKIM for the sending domain.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_FROM=no-reply@agropal.example.com
SECRET_SMTP=change-me

# Optional. Restrict the token to your domain in the Mapbox dashboard: it is visible in the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=
